// SPDX-License-Identifier: (GPL-2.0+ OR MIT)

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	model = "NLnet XiGuaPi V3";
	compatible = "nlnet,xiguapi-v3", "rockchip,rk3568";

	aliases {
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		mmc0 = &sdhci;
		mmc1 = &sdmmc0;
	};

	chosen {
		bootargs = "earlycon";
		stdout-path = "serial2:1500000n8";
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		key-scan-interval = <100>;
		poll-interval = <100>;

		reset-key {
			label = "reset";
			linux,code = <KEY_RESTART>;
			channel = <1>;
			threshold = <0>;
		};
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm14 0 50000>;
		enable-gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_HIGH>;
		default-brightness-level = <200>;
	};

	es8316-sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "HDMI";
		simple-audio-card,widgets = "Microphone", "Microphone Jack",
					    "Headphone", "Headphone Jack",
					    "Speaker", "Speaker Ext",
					    "Line", "Line In Jack";
		simple-audio-card,routing = "MIC1", "Microphone Jack",
					     "Headphone", "HPOL",
					     "Headphone", "HPOR",
					     "Speaker", "SPOL",
					     "Speaker", "SPOR",
					     "LL", "Line In Jack",
					     "Headphone", "HPOL",
					     "Headphone", "HPOR";
		simple-audio-card,cpu {
			sound-dai = <&i2s1_8ch>;
		};
		simple-audio-card,codec {
			sound-dai = <&es8316>;
		};
	};

	fan: pwm-fan {
		compatible = "pwm-fan";
		cooling-min-state = <0>;
		cooling-max-state = <4>;
		#cooling-cells = <2>;
		pwms = <&pwm7 0>;
		cooling-levels = <0 30 75 135 195 255>;
	};

	gpu: gpu {
		compatible = "rockchip,rk3568-mali";
		status = "okay";
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_b>;

		led-b {
			gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
			label = "sys_led";
			linux,default-trigger = "default-on";
		};

		net_led {
			gpios = <&gpio3 RK_PA4 GPIO_ACTIVE_HIGH>;
			label = "net_led";
			linux,default-trigger = "netdev";
			default-state = "off";
		};
	};

	rfkill-modem {
		compatible = "rfkill-gpio";
		label = "modem";
		radio-type = "wwan";
		reset-gpios = <&gpio2 RK_PD7 GPIO_ACTIVE_HIGH>;
		default-state = <0>;
	};

	spk_amp: spk-amp {
		compatible = "simple-audio-amplifier";
		sound-name-prefix = "Speaker Amp";
		gpios = <&gpio0 RK_PB2 GPIO_ACTIVE_HIGH>;
	};

	vcc0v6_ddr: vcc0v6-ddr {
		compatible = "regulator-fixed";
		regulator-name = "vcc0v6_ddr";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <600000>;
		regulator-max-microvolt = <600000>;
	};

	vcc3v3_pi6c: vcc3v3-pi6c {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pi6c";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3>;

		gpio = <&gpio0 RK_PD4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vcc3v3_sd: vcc3v3-sd {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sd";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3>;

		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vcc_3v3: vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	vcc_3v3_wifi: vcc-3v3-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_wifi";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3>;
	};

	vcc_4v0_5g: vcc-4v0-5g {
		compatible = "regulator-fixed";
		regulator-name = "vcc_4v0_5g";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <4000000>;
		regulator-max-microvolt = <4000000>;
		vin-supply = <&vcc5v>;

		gpio = <&gpio0 RK_PD6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vcc5v: vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	vcc5v0_usb_otg0: vcc5v0-usb-otg0 {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb_otg0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v>;

		gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vcc_sysin_b: vcc-sysin-b {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sysin_b";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <4000000>;
		regulator-max-microvolt = <4000000>;
	};

	vdd_gpu: vdd-gpu {
		compatible = "pwm-regulator";
		pwms = <&pwmdirect 0>;
		regulator-name = "vdd_gpu";
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <950000>;
		regulator-ramp-delay = <500>;
		status = "okay";
	};

	thermal-zones {
		cpu_thermal: cpu-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			thermal-sensors = <&tsadc 1>;

			trips {
				cpu_trip_budget: cpu-trip-budget {
					temperature = <55000>;
					hysteresis = <5000>;
					type = "passive";
				};
				cpu_trip_jade: cpu-trip-jade {
					temperature = <65000>;
					hysteresis = <5000>;
					type = "passive";
				};
				cpu_trip_hot: cpu-trip-hot {
					temperature = <75000>;
					hysteresis = <5000>;
					type = "passive";
				};
				cpu_trip_ffs: cpu-trip-ffs {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				cooler-budget {
					trip = <&cpu_trip_budget>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				cooler_jade {
					trip = <&cpu_trip_jade>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				cooler_hot {
					trip = <&cpu_trip_hot>;
					cooling-device = <&fan THERMAL_NO_LIMIT 1>;
				};
				cooler_ffs {
					trip = <&cpu_trip_ffs>;
					cooling-device = <&fan 3 THERMAL_NO_LIMIT>;
				};
			};
		};
	};

	wireless-wwan {
		compatible = "wireless-wwan";
	};
};

&combphy0 {
	status = "okay";
};

&combphy1 {
	status = "okay";
};

&combphy2 {
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
	operating-points-v2 = <&cpu0_opp_table>;
	clock-latency = <40000>;
	#cooling-cells = <2>;
};

&cpu0_opp_table {
	opp-600000000 {
		opp-hz = /bits/ 64 <600000000>;
		opp-microvolt = <850000>;
		clock-latency-ns = <40000>;
	};
	opp-800000000 {
		opp-hz = /bits/ 64 <800000000>;
		opp-microvolt = <850000>;
		clock-latency-ns = <40000>;
	};
	opp-1000000000 {
		opp-hz = /bits/ 64 <1000000000>;
		opp-microvolt = <900000>;
		clock-latency-ns = <40000>;
	};
	opp-1200000000 {
		opp-hz = /bits/ 64 <1200000000>;
		opp-microvolt = <1000000>;
		clock-latency-ns = <40000>;
	};
	opp-1416000000 {
		opp-hz = /bits/ 64 <1416000000>;
		opp-microvolt = <1100000>;
		clock-latency-ns = <40000>;
	};
	opp-1512000000 {
		opp-hz = /bits/ 64 <1512000000>;
		opp-microvolt = <1150000>;
		clock-latency-ns = <40000>;
		status = "okay";
	};
};

&cpu1 {
	cpu-supply = <&vdd_cpu>;
	operating-points-v2 = <&cpu0_opp_table>;
	#cooling-cells = <2>;
};

&cpu2 {
	cpu-supply = <&vdd_cpu>;
	operating-points-v2 = <&cpu0_opp_table>;
	#cooling-cells = <2>;
};

&cpu3 {
	cpu-supply = <&vdd_cpu>;
	operating-points-v2 = <&cpu0_opp_table>;
	#cooling-cells = <2>;
};

&dsi0 {
	status = "okay";
	rockchip,lane-rate = <594>;
	#address-cells = <1>;
	#size-cells = <0>;

	panel@0 {
		compatible = "simple-panel-dsi";
		reg = <0>;
		remove-gpios = <&gpio4 RK_PC4 GPIO_ACTIVE_HIGH>;
		dc-gpios = <&gpio4 RK_PC5 GPIO_ACTIVE_HIGH>;
		enable-gpios = <&gpio4 RK_PC4 GPIO_ACTIVE_HIGH>;
		rotation = <270>;
		backlight = <&backlight>;
		link-invert;
		port {
			panel_in_panel: endpoint {
				remote-endpoint = <&dsi_out_panel>;
			};
		};
	};
};

&dsi0_out {
	data-lanes = <0 1 2 3>;
	link-invert;
	port@0 {
		dsi_out_panel: endpoint {
			remote-endpoint = <&panel_in_panel>;
		};
	};
};

&dsi_in {
	data-lanes = <0 1 2 3>;
};

&es8316 {
	compatible = "everest,es8316";
	clocks = <&i2s1_8ch_mclk>;
	assigned-clocks = <&cru SCLK_I2S1_8CH_TX>;
	assigned-clock-rates = <24576000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2s1m0_mclk>;
	reg = <0x10>;
	status = "okay";
};

&gmac0 {
	clock_in_out = "output";
	phy-handle = <&rgmii_phy0>;
	phy-mode = "rgmii-id";
	snps,reset-gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_HIGH>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	phy-supply = <&vcc3v3_pi6c>;
	status = "okay";

	mdio0 {
		compatible = "snps,dwmac-mdio";
		rgmii_phy0: phy@1 {
			compatible = "ethernet-phy-id001c.c916";
			reg = <1>;
			reset-assert-us = <20000>;
			reset-deassert-us = <100000>;
			reset-gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_HIGH>;
		};
	};
};

&gmac1 {
	clock_in_out = "output";
	phy-handle = <&rgmii_phy1>;
	phy-mode = "rgmii-id";
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1m1_clkinout &gmac1m1_rx_bus2 &gmac1m1_tx_bus2>;
	snps,reset-gpio = <&gpio3 RK_PB0 GPIO_ACTIVE_HIGH>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	phy-supply = <&vcc3v3_pi6c>;
	status = "okay";

	mdio1 {
		compatible = "snps,dwmac-mdio";
		rgmii_phy1: phy@1 {
			compatible = "ethernet-phy-id001c.c916";
			reg = <1>;
			reset-assert-us = <20000>;
			reset-deassert-us = <100000>;
			reset-gpios = <&gpio3 RK_PB0 GPIO_ACTIVE_HIGH>;
		};
	};
};

&gpu {
	suppress-vma-alloc;
};

&hdmi {
	status = "okay";
	#sound-dai-cells = <0>;
};

&hdmi_sound {
	status = "okay";
};

&i2c0 {
	status = "okay";
	i2c-scl-rising-time-ns = <420>;
	i2c-scl-falling-time-ns = <30>;
	pmic@20 {
		compatible = "rockchip,rk809";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_int>;
		rockchip,system-power-controller;
		wakeup-source;

		vdd10-supply = <&vcc_3v3>;
		vdd18-supply = <&vcc_1v8>;
		vccio1-supply = <&vcc_3v3>;
		vccio2-supply = <&vcc_3v3>;
		vccio3-supply = <&vcc_3v3>;
		vccio4-supply = <&vcc_1v8>;
		vccio5-supply = <&vcc_3v3>;
		vccio6-supply = <&vcc_3v3>;
		vccio7-supply = <&vcc_3v3>;

		regulators {
			vdd_cpu: DCDC_REG1 {
				regulator-name = "vdd_cpu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1150000>;
				regulator-ramp-delay = <500>;
				regulator-settling-time-up-us = <500>;
				regulator-settling-time-down-us = <20000>;
				regulator-initial-mode = <0>;
				regulator-allowed-modes = <0 1>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_gpu: DCDC_REG2 {
				regulator-name = "vdd_gpu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <500>;
				regulator-initial-mode = <0>;
				regulator-allowed-modes = <0 1>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_ddr: DCDC_REG3 {
				regulator-name = "vcc_ddr";
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0>;

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vdd_logic_low: DCDC_REG4 {
				regulator-name = "vdd_logic_low";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-ramp-delay = <500>;
				regulator-initial-mode = <0>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <850000>;
				};
			};

			vcc_1v8: DCDC_REG5 {
				regulator-name = "vcc_1v8";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-initial-mode = <0>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vcc1v8_s3: LDO_REG1 {
				regulator-name = "vcc1v8_s3";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-initial-mode = <0>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc1v8_codec: LDO_REG2 {
				regulator-name = "vcc1v8_codec";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-initial-mode = <0>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc1v8_pmu: LDO_REG3 {
				regulator-name = "vcc1v8_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-initial-mode = <0>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vcc3v3_pmu: LDO_REG4 {
				regulator-name = "vcc3v3_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <0>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc_ddr_gpu: LDO_REG5 {
				regulator-name = "vcc_ddr_gpu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-initial-mode = <0>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <850000>;
				};
			};

			vcc3v3_sys: LDO_REG6 {
				regulator-name = "vcc3v3_sys";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <0>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc3v3_ht: LDO_REG7 {
				regulator-name = "vcc3v3_ht";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <0>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc3v3_lvp: LDO_REG8 {
				regulator-name = "vcc3v3_lvp";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <0>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc1v8_s0: LDO_REG9 {
				regulator-name = "vcc1v8_s0";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-initial-mode = <0>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vccio_acodec: LDO_REG10 {
				regulator-name = "vccio_acodec";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-initial-mode = <0>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};
	};

	tcs4525@1c {
		compatible = "tcs,tcs4525";
		reg = <0x1c>;
	 regulator-name = "vdd_cpu";
	 regulator-min-microvolt = <800000>;
	 regulator-max-microvolt = <1150000>;
	 vin-supply = <&vcc5v>;
	};
};

&i2s1_8ch {
	status = "okay";
};

&i2s1_8ch_mclk {
	status = "okay";
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";
};

&pcie30phy {
	status = "okay";
	clkreq-names = "pcie30_1lane";
	resets = <&cru SRST_PCIE30_PHY>;
	rockchip,ppc-timeout-us = <10000000>;
	rockchip,tx-term-offset = <3>;
};

&pcie30phy_pwr500ms {
	bit = <0 0x2000>;
};

&pcie30phy_pwr90ms {
	bit = <0x2000 0>;
};

&pcie30phy_pwren {
	bit = <0x2000 0x1>;
};

&pcie3x1 {
	status = "okay";
	reset-gpios = <&gpio3 RK_PA1 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc_3v3_wifi>;
	rockchip,max-clkreq-unsupported;
};

&pcie3x2 {
	status = "okay";
	reset-gpios = <&gpio2 RK_PD6 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc_3v3_wifi>;
	rockchip,max-clkreq-unsupported;
};

&pcie3x2_immap {
	reset-names = "perst";
	resets = <&cru SRST_PCIE3X2>;
};

&pcie3x2_panphy {
	bit = <0x2000 0x1>;
};

&pinctrl {
	bl: bl-con {
		rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
	};

	bt1140: bt1140-con {
		rockchip,pins = <0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
	};

	bt6565: bt6565-con {
