		spi3m1_miso: spi3m1-miso {
			rockchip,pins = <1 RK_PC7 RK_FUNC4 &pcfg_pull_none>;
		};

		spi3m1_mosi: spi3m1-mosi {
			rockchip,pins = <2 RK_PA0 RK_FUNC4 &pcfg_pull_none>;
		};
	};

	spi3m1_pins: spi3m1-pins {
		rockchip,pins = <1 RK_PC5 RK_FUNC4 &pcfg_pull_none>;
	};

	tsadc {
		tsadc_imap: tsadc-imap {
			rockchip,pins = <0 RK_PA7 RK_FUNC1 &pcfg_pull_none>;
		};

		tsadc_imap_ot: tsadc-imap-ot {
			rockchip,pins = <0 RK_PB0 RK_FUNC1 &pcfg_pull_none>;
		};
	};

	u2phy0 {
		u2phy0_otg: u2phy0-otg {
			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	uart0 {
		uart0m1: uart0m1-con {
			rockchip,pins = <0 RK_PC2 RK_FUNC1 &pcfg_pull_none>;
		};

		uart0m1_cts: uart0m1-cts {
			rockchip,pins = <0 RK_PC3 RK_FUNC1 &pcfg_pull_none>;
		};

		uart0m1_rts: uart0m1-rts {
			rockchip,pins = <0 RK_PC4 RK_FUNC1 &pcfg_pull_none>;
		};

		uart0m1_xfer: uart0m1-xfer {
			rockchip,pins = <0 RK_PC2 RK_FUNC1 &pcfg_pull_none>,
					 <0 RK_PC3 RK_FUNC1 &pcfg_pull_none>,
					 <0 RK_PC4 RK_FUNC1 &pcfg_pull_none>,
					 <0 RK_PC5 RK_FUNC1 &pcfg_pull_none>;
		};

		uart0m2: uart0m2-con {
			rockchip,pins = <4 RK_PB2 RK_FUNC2 &pcfg_pull_none>;
		};

		uart0m2_cts: uart0m2-cts {
			rockchip,pins = <4 RK_PB3 RK_FUNC2 &pcfg_pull_none>;
		};

		uart0m2_rts: uart0m2-rts {
			rockchip,pins = <4 RK_PB4 RK_FUNC2 &pcfg_pull_none>;
		};

		uart0m2_xfer: uart0m2-xfer {
			rockchip,pins = <4 RK_PB2 RK_FUNC2 &pcfg_pull_none>,
					 <4 RK_PB3 RK_FUNC2 &pcfg_pull_none>,
					 <4 RK_PB4 RK_FUNC2 &pcfg_pull_none>,
					 <4 RK_PB5 RK_FUNC2 &pcfg_pull_none>;
		};
	};

	uart1 {
		uart1m1: uart1m1-con {
			rockchip,pins = <7 RK_PA0 RK_FUNC2 &pcfg_pull_none>;
		};

		uart1m1_cts: uart1m1-cts {
			rockchip,pins = <7 RK_PA1 RK_FUNC2 &pcfg_pull_none>;
		};

		uart1m1_rts: uart1m1-rts {
			rockchip,pins = <7 RK_PA2 RK_FUNC2 &pcfg_pull_none>;
		};

		uart1m1_xfer: uart1m1-xfer {
			rockchip,pins = <7 RK_PA0 RK_FUNC2 &pcfg_pull_none>,
					 <7 RK_PA1 RK_FUNC2 &pcfg_pull_none>,
					 <7 RK_PA2 RK_FUNC2 &pcfg_pull_none>,
					 <7 RK_PA3 RK_FUNC2 &pcfg_pull_none>;
		};
	};

	uart2 {
		uart2m1: uart2m1-con {
			rockchip,pins = <3 RK_PB6 RK_FUNC1 &pcfg_pull_none>;
		};

		uart2m1_cts: uart2m1-cts {
			rockchip,pins = <3 RK_PB7 RK_FUNC1 &pcfg_pull_none>;
		};

		uart2m1_rts: uart2m1-rts {
			rockchip,pins = <4 RK_PA0 RK_FUNC1 &pcfg_pull_none>;
		};

		uart2m1_xfer: uart2m1-xfer {
			rockchip,pins = <3 RK_PB6 RK_FUNC1 &pcfg_pull_none>,
					 <3 RK_PB7 RK_FUNC1 &pcfg_pull_none>,
					 <4 RK_PA0 RK_FUNC1 &pcfg_pull_none>,
					 <4 RK_PA1 RK_FUNC1 &pcfg_pull_none>;
		};

		uart2m2: uart2m2-con {
			rockchip,pins = <0 RK_PC6 RK_FUNC3 &pcfg_pull_none>;
		};

		uart2m2_xfer: uart2m2-xfer {
			rockchip,pins = <0 RK_PC6 RK_FUNC3 &pcfg_pull_none>,
					 <0 RK_PC7 RK_FUNC3 &pcfg_pull_none>;
		};
	};

	usb2phy0 {
		usb2phy0_host: host {
			rockchip,pins = <4 RK_PC5 RK_FUNC1 &pcfg_pull_none>;
		};
	};

	usb2phy0_otg: otg {
		rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
	};

	usb2phy1 {
		usb2phy1_host: host {
			rockchip,pins = <4 RK_PC7 RK_FUNC1 &pcfg_pull_none>;
		};
	};

	vcc1v0_s3: vcc1v0-s3-con {
		rockchip,pins = <1 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
	};
};

&pmu_pwr_mode {
	cpu0_vdd: cpu0-vdd {
		pwroff-pre-delay-us = <20000>;
		pwroff-post-delay-us = <70000>;
	};

	cpu1_vdd: cpu1-vdd {
		pwroff-pre-delay-us = <20000>;
		pwroff-post-delay-us = <70000>;
	};

	cpu2_vdd: cpu2-vdd {
		pwroff-pre-delay-us = <20000>;
		pwroff-post-delay-us = <70000>;
	};

	cpu3_vdd: cpu3-vdd {
		pwroff-pre-delay-us = <20000>;
		pwroff-post-delay-us = <70000>;
	};
};

&pwm7 {
	status = "okay";
};

&pwm14 {
	status = "okay";
};

&pwmdirect {
	status = "okay";
};

&saradc {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&sdhci {
	bus-width = <8>;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&mmc0im1_clk &mmc0im1_cmd &mmc0im1_data0 &mmc0im1_data1 &mmc0im1_data2 &mmc0im1_data3 &mmc0im1_data4 &mmc0im1_data5 &mmc0im1_data6 &mmc0im1_data7 &mmc0im1_ds>;
	status = "okay";
};

&sdmmc0 {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	disable-wp;
	keep-power-in-suspend;
	pinctrl-names = "default";
	pinctrl-0 = <&mmc1im0_clk &mmc1im0_cmd &mmc1im0_data0 &mmc1im0_data1 &mmc1im0_data2 &mmc1im0_data3 &mmc1im0_ds>;
	sd-uhs-sdr50;
	vmmc-supply = <&vcc3v3_sd>;
	vqmmc-supply = <&vcc_3v3>;
	status = "okay";
};

&sfc {
	status = "okay";
};

&sfc_norflash {
	status = "okay";
};

&spdif1 {
	status = "okay";
};

&spi3 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi3m1 &spi3m1_clk &spi3m1_miso &spi3m1_mosi &spi3m1_cs0>;
	pmic@0 {
		compatible = "rockchip,rk628-lvds";
		reg = <0x0>;
	};

	panel@1 {
		compatible = "galaxycore,gc9307";
		reg = <0x1>;
		dc-gpios = <&gpio4 RK_PC5 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio4 RK_PC4 GPIO_ACTIVE_HIGH>;
		spi-3wire;
		spi-cs-high;
		spi-max-frequency = <20000000>;
		backlight = <&backlight>;
		rotation = <270>;
		status = "okay";
	};
};

&tsadc {
	status = "okay";
	rockchip,hw-tshut-mode = <0>;
	rockchip,hw-tshut-polarity = <0>;
rockchip,tsadc-temp-hysteresis = <0>;
rockchip,tsadc-thermal-routine = <0>;
};

