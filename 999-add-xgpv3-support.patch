--- a/target/linux/rockchip/image.mk
+++ b/target/linux/rockchip/image.mk
@@ -1,3 +1,32 @@
+# =====================================================================
+# Xiguapi V3 (nlnet_xiguapi-v3) 设备支持
+# =====================================================================
+
+define Device/nlnet_xiguapi-v3
+  $(call Device/FamilyRockchip,rk3568)
+  DEVICE_VENDOR := NLnet
+  DEVICE_MODEL := XiGuaPi V3
+  DEVICE_DTS := rk3568-xiguapi-v3
+  KERNEL_LOADADDR := 0x03000000
+  BOOT_FLOW := pine64-img
+  DEVICE_PACKAGES := \
+    kmod-hwmon-pwmfan \
+    kmod-input-adc-keys \
+    kmod-saradc-rockchip \
+    kmod-mhi-pci-generic \
+    kmod-mhi-pci-qcom-gen \
+    kmod-usb-net-qmi-wwan \
+    kmod-usb-net-cdc-mbim \
+    kmod-usb-net-rndis \
+    luci-proto-modemmanager \
+    luci-app-modemmanager \
+    $(DEVICE_PACKAGES_BASIC)
+endef
+TARGET_DEVICES += nlnet_xiguapi-v3
